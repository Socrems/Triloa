{
  "manifest_version": 3,
  "name": "Triloa 网页双语翻译",
  "version": "0.1.3",
  "description": "按网站启用双语翻译，在正文、标题和列表项下方显示本地模型生成的中文译文。",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8765/*"
  ],
  "action": {
    "default_title": "Triloa 网页双语翻译",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": ["model_cache.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
